<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  RapidClicker posts synthetic mouse events into other applications, which
	  the App Sandbox forbids. The sandbox is therefore intentionally disabled;
	  the app instead relies on the user granting Accessibility permission at
	  runtime. (This also means the app is not eligible for the Mac App Store.)
	-->
</dict>
</plist>
